# ============================================
# SmartAgentTrade — Environment Variables
# ============================================
# 1. Copy file นี้ แล้วตั้งชื่อใหม่เป็น .env
# 2. ใส่ค่าจริงแทน xxx...
# 3. ห้าม commit .env ขึ้น git เด็ดขาด
# ============================================

# --- Claude API ---
# สมัครที่: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxx...

# --- Telegram ---
# BOT_TOKEN: ได้จาก @BotFather ใน Telegram
# CHAT_ID: ได้จาก @userinfobot ใน Telegram
TELEGRAM_BOT_TOKEN=xxx:xxx-xxx
TELEGRAM_CHAT_ID=xxx

# --- Trading Config ---
TRADING_PAIR=XAUUSD
SCAN_INTERVAL_MINUTES=15
MAX_RISK_PERCENT=2.0
BALANCE=10000.0          # balance สำหรับคำนวณ lot (ถ้าไม่ได้เชื่อม MT5)
FIXED_LOT=0.0            # ถ้า > 0 → ใช้ lot นี้เลย ไม่คำนวณจาก risk% (demo ใช้ 0.01)
MAX_LOT=0.1              # lot สูงสุดต่อ 1 ไม้ (pyramid = 3 ไม้ รวมไม่เกิน MAX_LOT × 3)

# --- Session Config ---
LONDON_SESSION_START=14:00
LONDON_SESSION_END=23:00
NEW_YORK_SESSION_START=19:00
NEW_YORK_SESSION_END=04:00
NEWS_BLOCK_MINUTES=30

# --- News Calendar API (เลือกอย่างน้อย 1 อย่าง) ---
# FMP: สมัครฟรีที่ https://financialmodelingprep.com (250 calls/day)
FMP_API_KEY=

# Finnhub: สมัครฟรีที่ https://finnhub.io (60 calls/min)
# ถ้าไม่มีทั้งคู่ → ใช้ Heuristic fallback อัตโนมัติ
FINNHUB_API_KEY=

# --- MT5 Auto-Execute (Windows only) ---
# ตั้ง MT5_ENABLED=true เพื่อเปิด auto-execute
# ค่า Login/Password/Server ดูได้จาก MT5 → File → Open Account
MT5_ENABLED=false
MT5_PATH=C:\Program Files\MetaTrader 5 - Copy\terminal64.exe
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=ICMarkets-Demo
MT5_SYMBOL=XAUUSD
MT5_MAGIC=20250101
MT5_MAX_SLIPPAGE_PIPS=3

# --- POS Guard (trailing stop per-position) ---
# เปิด POSGUARD_ENABLED=true เพื่อให้ bot เลื่อน SL อัตโนมัติ
# ต้องใช้คู่กับ MT5_ENABLED=true
POSGUARD_ENABLED=false
POSGUARD_TRIGGER_USD=20.0      # profit $ ก่อน lock SL
POSGUARD_LOCK_TICKS=10.0       # ticks เหนือ open หลัง lock (10 ticks = $0.10/lot)
POSGUARD_STEP_TICKS=500.0      # trail step ticks (500 ticks = $5.00/lot ต่อ step)
POSGUARD_CHECK_INTERVAL=10     # เช็คทุกกี่วินาที
