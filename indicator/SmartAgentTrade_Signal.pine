// This Pine Script™ code is subject to the Mozilla Public License 2.0
// © SmartAgentTrade — Merged: SAT Signal + SMC_Strategy_Beam
// Strategy: SMC Swing Entry (OB Retest / Sweep Grab / EQL-EQH Sweep)
//@version=5
indicator("SmartAgentTrade — Bot Signal", shorttitle="SAT-Bot", overlay=true,
          max_boxes_count=60, max_lines_count=300, max_labels_count=250)

// ═══════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════
g_sw = "Swing / Structure"
i_swing_len  = input.int(5, "Swing Length (bars each side)", group=g_sw, minval=2, maxval=20)
i_ob_swing   = input.int(2, "OB Swing Length",               group=g_sw, minval=1, maxval=10)

g_ob = "Order Blocks"
i_show_bull_ob = input.bool(true,  "Show Bullish OB boxes", group=g_ob)
i_show_bear_ob = input.bool(true,  "Show Bearish OB boxes", group=g_ob)
i_max_ob       = input.int(5,      "Max OB per side",        group=g_ob, minval=1, maxval=10)

g_fvg = "Fair Value Gap"
i_show_fvg = input.bool(true, "Show FVG", group=g_fvg)

g_struct = "Structure"
i_show_bos   = input.bool(true, "Show BOS",   group=g_struct)
i_show_choch = input.bool(true, "Show CHoCH", group=g_struct)

g_sweep = "Liquidity Sweep"
i_show_sweep  = input.bool(true, "Show Sweep labels",    group=g_sweep)
i_sweep_age   = input.int(3,     "Sweep max age (bars)", group=g_sweep, minval=1, maxval=10)

g_eql = "Equal H/L"
i_show_eql   = input.bool(true,  "Show EQH/EQL lines",  group=g_eql)
i_eql_thresh = input.float(0.1, "EQH/EQL tolerance (%)", group=g_eql, minval=0.01, maxval=1.0, step=0.01)

g_htf = "HTF Bias (real H1/H4/D1)"
i_show_htf_lines = input.bool(false, "Show HTF midpoint lines", group=g_htf)

g_sig = "Signal Filters"
i_atr_period = input.int(14,   "ATR Period",                     group=g_sig)
i_mom_mult   = input.float(2.5,"Momentum Block (ATR×)",          group=g_sig, minval=1.0, maxval=5.0, step=0.1)
i_choch_age  = input.int(5,    "CHoCH max age (bars)",           group=g_sig)
i_min_body   = input.float(0.5,"Min body ratio confirm candle",  group=g_sig, minval=0.1, maxval=0.9, step=0.05)

g_sl = "SL / TP"
i_show_sltp = input.bool(true, "Show SL/TP Lines", group=g_sl)
i_rr_min    = input.float(2.0, "Min RR",           group=g_sl, minval=1.0, step=0.5)

g_sess = "Session"
i_show_session   = input.bool(true, "Show Session Background", group=g_sess)
i_filter_session = input.bool(true, "Filter: London+NY only",  group=g_sess)

g_bot = "Bot Entry Markers"
i_show_bot = input.bool(true, "Show 🤖 Bot Entry Arrows", group=g_bot)

g_col = "Colors"
i_bull_col    = input.color(color.new(#00E676, 0),  "Bull Color",   group=g_col)
i_bear_col    = input.color(color.new(#FF1744, 0),  "Bear Color",   group=g_col)
i_ob_bull_col = input.color(color.new(#00E676, 82), "Bull OB Fill", group=g_col)
i_ob_bear_col = input.color(color.new(#FF1744, 82), "Bear OB Fill", group=g_col)

// ═══════════════════════════════════════════════════════════════════
// SESSION (Thai UTC+7)
// ═══════════════════════════════════════════════════════════════════
int   hour_thai = hour(time, "Asia/Bangkok")
int   min_thai  = minute(time, "Asia/Bangkok")
float t_thai    = hour_thai + min_thai / 60.0

is_london    = t_thai >= 14.0 and t_thai < 23.0
is_ny        = t_thai >= 19.0 or t_thai < 4.0
is_overlap   = is_london and is_ny
is_tradeable = is_london or is_ny

sess_bg = is_overlap ? color.new(#9C27B0, 92) : is_ny ? color.new(#F44336, 94) : is_london ? color.new(#FFC107, 95) : na
bgcolor(i_show_session ? sess_bg : na, title="Session BG")

// ═══════════════════════════════════════════════════════════════════
// ATR
// ═══════════════════════════════════════════════════════════════════
atr = ta.atr(i_atr_period)

// ═══════════════════════════════════════════════════════════════════
// HTF BIAS — request.security (H1, H4, D1 จริง)
// ═══════════════════════════════════════════════════════════════════
h1_h = request.security(syminfo.tickerid, "60",  ta.highest(high, 20))
h1_l = request.security(syminfo.tickerid, "60",  ta.lowest(low,  20))
h1_c = request.security(syminfo.tickerid, "60",  close)
h4_h = request.security(syminfo.tickerid, "240", ta.highest(high, 20))
h4_l = request.security(syminfo.tickerid, "240", ta.lowest(low,  20))
h4_c = request.security(syminfo.tickerid, "240", close)
d1_h = request.security(syminfo.tickerid, "D",   ta.highest(high, 20))
d1_l = request.security(syminfo.tickerid, "D",   ta.lowest(low,  20))
d1_c = request.security(syminfo.tickerid, "D",   close)

h1_mid = (h1_h + h1_l) / 2.0
h4_mid = (h4_h + h4_l) / 2.0
d1_mid = (d1_h + d1_l) / 2.0
h1_bull = h1_c > h1_mid
h4_bull = h4_c > h4_mid
d1_bull = d1_c > d1_mid

if i_show_htf_lines
    plot(h1_mid, "H1 Mid", color=color.new(#00BCD4, 60), linewidth=1)
    plot(h4_mid, "H4 Mid", color=color.new(#9C27B0, 60), linewidth=1)

// ═══════════════════════════════════════════════════════════════════
// SWING POINTS
// ═══════════════════════════════════════════════════════════════════
ph    = ta.pivothigh(high, i_swing_len, i_swing_len)
pl    = ta.pivotlow (low,  i_swing_len, i_swing_len)
ob_ph = ta.pivothigh(high, i_ob_swing,  i_ob_swing)
ob_pl = ta.pivotlow (low,  i_ob_swing,  i_ob_swing)

var float[] sh_prices = array.new_float(0)
var float[] sl_prices = array.new_float(0)

if not na(ph)
    array.push(sh_prices, ph)
    if array.size(sh_prices) > 10
        array.shift(sh_prices)

if not na(pl)
    array.push(sl_prices, pl)
    if array.size(sl_prices) > 10
        array.shift(sl_prices)

plotshape(not na(ph), "Swing High", shape.triangledown, location.abovebar, color=color.new(i_bear_col, 40), size=size.tiny, offset=-i_swing_len)
plotshape(not na(pl), "Swing Low",  shape.triangleup,   location.belowbar, color=color.new(i_bull_col, 40), size=size.tiny, offset=-i_swing_len)

// ═══════════════════════════════════════════════════════════════════
// STRUCTURE: BOS / CHoCH
// ═══════════════════════════════════════════════════════════════════
var float  last_sh     = na
var float  last_sl     = na
var string bias        = "neutral"
var string struct_type = na
var string struct_dir  = na
var int    struct_bar  = na

if not na(ph)
    last_sh := ph
if not na(pl)
    last_sl := pl

if not na(last_sh) and close > last_sh[1]
    new_t = bias == "bearish" ? "CHoCH" : "BOS"
    if new_t == "BOS" and i_show_bos
        label.new(bar_index, high, "BOS▲", style=label.style_label_down, color=i_bull_col, textcolor=color.white, size=size.tiny)
    if new_t == "CHoCH" and i_show_choch
        label.new(bar_index, high, "CHoCH▲", style=label.style_label_down, color=color.new(#00BCD4, 0), textcolor=color.white, size=size.tiny)
    struct_type := new_t
    struct_dir  := "bullish"
    struct_bar  := bar_index
    bias        := "bullish"

if not na(last_sl) and close < last_sl[1]
    new_t = bias == "bullish" ? "CHoCH" : "BOS"
    if new_t == "BOS" and i_show_bos
        label.new(bar_index, low, "BOS▼", style=label.style_label_up, color=i_bear_col, textcolor=color.white, size=size.tiny)
    if new_t == "CHoCH" and i_show_choch
        label.new(bar_index, low, "CHoCH▼", style=label.style_label_up, color=color.new(#FF9800, 0), textcolor=color.white, size=size.tiny)
    struct_type := new_t
    struct_dir  := "bearish"
    struct_bar  := bar_index
    bias        := "bearish"

bias_bull = bias == "bullish"
bias_bear = bias == "bearish"

// ═══════════════════════════════════════════════════════════════════
// LIQUIDITY SWEEP
// ═══════════════════════════════════════════════════════════════════
var float sh_track = na
var float sl_track = na

if not na(ob_ph)
    sh_track := ob_ph
if not na(ob_pl)
    sl_track := ob_pl

sweep_high = not na(sh_track) and high > sh_track and close <= sh_track
sweep_low  = not na(sl_track) and low  < sl_track and close >= sl_track

if sweep_high and i_show_sweep
    label.new(bar_index, high + atr * 0.3, "🌊H", style=label.style_label_down, color=color.new(i_bear_col, 20), textcolor=color.white, size=size.tiny)
if sweep_low and i_show_sweep
    label.new(bar_index, low - atr * 0.3,  "🌊L", style=label.style_label_up,   color=color.new(i_bull_col, 20), textcolor=color.white, size=size.tiny)

// Recent sweep (ใน i_sweep_age bars)
lb = math.min(20, bar_index)
recent_sweep_l = false
recent_sweep_h = false

for i = 1 to i_sweep_age
    if low[i]  < ta.lowest(low,   lb)[i] and not recent_sweep_l
        recent_sweep_l := true
for i = 1 to i_sweep_age
    if high[i] > ta.highest(high, lb)[i] and not recent_sweep_h
        recent_sweep_h := true

// ═══════════════════════════════════════════════════════════════════
// ORDER BLOCKS (boxes — port from EA DetectOrderBlocks)
// ═══════════════════════════════════════════════════════════════════
var box[] bull_ob_boxes = array.new<box>()
var box[] bear_ob_boxes = array.new<box>()

// Bullish OB: pivot high → หาแท่งแดงสุดท้ายก่อน high
if not na(ob_ph) and barstate.isconfirmed
    ob_h_v = ob_ph
    ob_l_v = low[i_ob_swing]
    for k = 1 to i_ob_swing - 1
        if close[k] < open[k]
            ob_h_v := high[k]
            ob_l_v := low[k]
    if i_show_bull_ob and array.size(bull_ob_boxes) < i_max_ob
        b = box.new(bar_index - i_ob_swing, ob_h_v, bar_index + 20, ob_l_v, border_color=i_bull_col, bgcolor=i_ob_bull_col, border_width=1)
        array.push(bull_ob_boxes, b)

// Bearish OB: pivot low → หาแท่งเขียวสุดท้ายก่อน low
if not na(ob_pl) and barstate.isconfirmed
    ob_h_v = high[i_ob_swing]
    ob_l_v = ob_pl
    for k = 1 to i_ob_swing - 1
        if close[k] > open[k]
            ob_h_v := high[k]
            ob_l_v := low[k]
    if i_show_bear_ob and array.size(bear_ob_boxes) < i_max_ob
        b = box.new(bar_index - i_ob_swing, ob_h_v, bar_index + 20, ob_l_v, border_color=i_bear_col, bgcolor=i_ob_bear_col, border_width=1)
        array.push(bear_ob_boxes, b)

// Extend and mitigate
if barstate.isconfirmed
    for i = 0 to array.size(bull_ob_boxes) - 1
        b = array.get(bull_ob_boxes, i)
        if not na(b)
            box.set_right(b, bar_index + 20)
            if close < box.get_bottom(b)
                box.set_border_color(b, color.new(i_bull_col, 70))
                box.set_bgcolor(b, color.new(i_bull_col, 96))
    for i = 0 to array.size(bear_ob_boxes) - 1
        b = array.get(bear_ob_boxes, i)
        if not na(b)
            box.set_right(b, bar_index + 20)
            if close > box.get_top(b)
                box.set_border_color(b, color.new(i_bear_col, 70))
                box.set_bgcolor(b, color.new(i_bear_col, 96))

// In OB check — direction: Bull OB ต้องมี recent high เหนือ OB top (retest จากบน)
recent_high_5 = ta.highest(high, 6)[1]
recent_low_5  = ta.lowest(low,  6)[1]

in_bull_ob = false
in_bear_ob = false
bull_ob_top = float(na)
bull_ob_bot = float(na)
bear_ob_top = float(na)
bear_ob_bot = float(na)

if array.size(bull_ob_boxes) > 0
    b = array.get(bull_ob_boxes, array.size(bull_ob_boxes) - 1)
    if not na(b)
        _top = box.get_top(b)
        _bot = box.get_bottom(b)
        if close >= _bot and close <= _top and recent_high_5 > _top
            in_bull_ob  := true
            bull_ob_top := _top
            bull_ob_bot := _bot

if array.size(bear_ob_boxes) > 0
    b = array.get(bear_ob_boxes, array.size(bear_ob_boxes) - 1)
    if not na(b)
        _top = box.get_top(b)
        _bot = box.get_bottom(b)
        if close >= _bot and close <= _top and recent_low_5 < _bot
            in_bear_ob  := true
            bear_ob_top := _top
            bear_ob_bot := _bot

// ═══════════════════════════════════════════════════════════════════
// FAIR VALUE GAPS
// ═══════════════════════════════════════════════════════════════════
fvg_min  = 2.0 * syminfo.mintick * 10
bull_fvg = low > high[2] and (low - high[2]) > fvg_min
bear_fvg = high < low[2] and (low[2] - high) > fvg_min

var box[] fvg_bull_boxes = array.new<box>()
var box[] fvg_bear_boxes = array.new<box>()

if bull_fvg and i_show_fvg and barstate.isconfirmed
    array.push(fvg_bull_boxes, box.new(bar_index - 2, low, bar_index + 30, high[2], border_color=color.new(#26C6DA, 40), bgcolor=color.new(#26C6DA, 85), border_width=1))
if bear_fvg and i_show_fvg and barstate.isconfirmed
    array.push(fvg_bear_boxes, box.new(bar_index - 2, low[2], bar_index + 30, high, border_color=color.new(#FF6F00, 40), bgcolor=color.new(#FF6F00, 85), border_width=1))

if barstate.isconfirmed
    for i = 0 to array.size(fvg_bull_boxes) - 1
        b = array.get(fvg_bull_boxes, i)
        if not na(b)
            box.set_right(b, bar_index + 30)
            if low < box.get_bottom(b)
                box.set_bgcolor(b, color.new(#26C6DA, 97))
    for i = 0 to array.size(fvg_bear_boxes) - 1
        b = array.get(fvg_bear_boxes, i)
        if not na(b)
            box.set_right(b, bar_index + 30)
            if high > box.get_top(b)
                box.set_bgcolor(b, color.new(#FF6F00, 97))

// ═══════════════════════════════════════════════════════════════════
// EQUAL HIGHS / LOWS (EQH / EQL)
// ═══════════════════════════════════════════════════════════════════
eql_thr = i_eql_thresh / 100.0
var float prev_sh_price = na
var float prev_sl_price = na
var float eqh_level     = na
var float eql_level     = na
near_eqh = false
near_eql = false

if not na(ph)
    if not na(prev_sh_price)
        if math.abs(ph - prev_sh_price) / prev_sh_price <= eql_thr
            eqh_level := (ph + prev_sh_price) / 2.0
            near_eqh  := true
            if i_show_eql
                line.new(bar_index - i_swing_len * 2, prev_sh_price, bar_index, ph, color=color.new(#FFD600, 60), style=line.style_dashed, width=1)
                label.new(bar_index, math.max(prev_sh_price, ph) + atr * 0.2, "EQH", color=color.new(#FFD600, 20), textcolor=color.white, style=label.style_label_down, size=size.tiny)
    prev_sh_price := ph

if not na(pl)
    if not na(prev_sl_price)
        if math.abs(pl - prev_sl_price) / prev_sl_price <= eql_thr
            eql_level := (pl + prev_sl_price) / 2.0
            near_eql  := true
            if i_show_eql
                line.new(bar_index - i_swing_len * 2, prev_sl_price, bar_index, pl, color=color.new(#CE93D8, 60), style=line.style_dashed, width=1)
                label.new(bar_index, math.min(prev_sl_price, pl) - atr * 0.2, "EQL", color=color.new(#CE93D8, 20), textcolor=color.white, style=label.style_label_up, size=size.tiny)
    prev_sl_price := pl

// EQL/EQH Sweep (CASE D) — swept แล้ว recover
eql_swept = near_eql and not na(eql_level) and low[1] < eql_level and close > eql_level
eqh_swept = near_eqh and not na(eqh_level) and high[1] > eqh_level and close < eqh_level

// ═══════════════════════════════════════════════════════════════════
// CONFIRMATION CANDLE
// ═══════════════════════════════════════════════════════════════════
body_sz  = math.abs(close - open)
c_range  = high - low
c_r      = math.max(c_range, syminfo.mintick)
bull_candle = close > open and body_sz / c_r >= i_min_body
bear_candle = close < open and body_sz / c_r >= i_min_body

// ═══════════════════════════════════════════════════════════════════
// MOMENTUM FILTER
// ═══════════════════════════════════════════════════════════════════
drop_5        = ta.highest(high, 6)[1] - close
rally_5       = close - ta.lowest(low, 6)[1]
momentum_bear = drop_5  > atr * i_mom_mult
momentum_bull = rally_5 > atr * i_mom_mult

plotshape(momentum_bear, "Mom Bear", shape.xcross, location.abovebar, color=color.new(i_bear_col, 40), size=size.tiny)
plotshape(momentum_bull, "Mom Bull", shape.xcross, location.belowbar, color=color.new(i_bull_col, 40), size=size.tiny)

// ═══════════════════════════════════════════════════════════════════
// GRAB STRENGTH (wick ratio)
// ═══════════════════════════════════════════════════════════════════
bull_wr          = close > open ? (close - low) / c_r : 0.0
bear_wr          = close < open ? (high - close) / c_r : 0.0
bull_grab        = recent_sweep_l and close > open and bull_wr > 0.50
bull_grab_strong = recent_sweep_l and close > open and bull_wr > 0.65
bear_grab        = recent_sweep_h and close < open and bear_wr > 0.50
bear_grab_strong = recent_sweep_h and close < open and bear_wr > 0.65

struct_sweep_long  = recent_sweep_l and bull_grab
struct_sweep_short = recent_sweep_h and bear_grab

// ═══════════════════════════════════════════════════════════════════
// CHoCH RECENCY
// ═══════════════════════════════════════════════════════════════════
var int    choch_bar_idx  = na
var string choch_last_dir = na

choch_bull_now = struct_type == "CHoCH" and struct_dir == "bullish" and struct_bar == bar_index
choch_bear_now = struct_type == "CHoCH" and struct_dir == "bearish" and struct_bar == bar_index

if choch_bull_now or choch_bear_now
    choch_bar_idx  := bar_index
    choch_last_dir := choch_bull_now ? "bullish" : "bearish"

choch_age       = not na(choch_bar_idx) ? bar_index - choch_bar_idx : 999
recent_choch_bull = choch_last_dir == "bullish" and choch_age <= i_choch_age
recent_choch_bear = choch_last_dir == "bearish" and choch_age <= i_choch_age

bull_choch_grab = recent_choch_bull and recent_sweep_l and close > open and bull_wr > 0.5
bear_choch_grab = recent_choch_bear and recent_sweep_h and close < open and bear_wr > 0.5

// ═══════════════════════════════════════════════════════════════════
// CONFLUENCE SCORE ★★★
// ═══════════════════════════════════════════════════════════════════
long_score  = (in_bull_ob ? 1 : 0) + (h1_bull ? 1 : 0) + (h4_bull ? 1 : 0) + (bull_choch_grab ? 1 : 0) + (struct_sweep_long ? 2 : 0)
short_score = (in_bear_ob ? 1 : 0) + (not h1_bull ? 1 : 0) + (not h4_bull ? 1 : 0) + (bear_choch_grab ? 1 : 0) + (struct_sweep_short ? 2 : 0)

long_stars  = long_score  >= 4 ? "★★★" : long_score  >= 2 ? "★★" : "★"
short_stars = short_score >= 4 ? "★★★" : short_score >= 2 ? "★★" : "★"

// ═══════════════════════════════════════════════════════════════════
// SIGNAL CONDITIONS (A/B/B2/C/D)
// ═══════════════════════════════════════════════════════════════════
// A: Trend + OB retest
long_a  = bias_bull and h4_bull and in_bull_ob and bull_candle and not momentum_bear
short_a = bias_bear and not h4_bull and in_bear_ob and bear_candle and not momentum_bull

// B: Sweep + Grab
long_b  = bull_grab and (h4_bull or struct_sweep_long) and not momentum_bear
short_b = bear_grab and (not h4_bull or struct_sweep_short) and not momentum_bull

// B2: Strong Grab
long_b2  = bull_grab_strong and not momentum_bear
short_b2 = bear_grab_strong and not momentum_bull

// C: CHoCH + Sweep
long_c  = bull_choch_grab and not momentum_bear
short_c = bear_choch_grab and not momentum_bull

// D: EQL/EQH Sweep
long_d  = eql_swept and bull_candle and not momentum_bear
short_d = eqh_swept and bear_candle and not momentum_bull

long_any  = long_a  or long_b  or long_b2 or long_c or long_d
short_any = short_a or short_b or short_b2 or short_c or short_d

long_sig  = long_any  and (not i_filter_session or is_tradeable)
short_sig = short_any and (not i_filter_session or is_tradeable)

sig_type_l = long_d  ? "D·EQL"    : long_c  ? "C·CHoCH" : long_b2  ? "B2·Grab" : long_b  ? "B·Sweep" : "A·OB"
sig_type_s = short_d ? "D·EQH"    : short_c ? "C·CHoCH" : short_b2 ? "B2·Grab" : short_b ? "B·Sweep" : "A·OB"

// ═══════════════════════════════════════════════════════════════════
// SIGNAL LABELS (triangle + stars)
// ═══════════════════════════════════════════════════════════════════
long_col_s  = long_score  >= 4 ? #00C853 : long_score  >= 2 ? color.new(#00C853, 25) : color.new(#00C853, 55)
short_col_s = short_score >= 4 ? #D50000 : short_score >= 2 ? color.new(#D50000, 25) : color.new(#D50000, 55)

if long_sig
    label.new(bar_index, low - atr * 0.5, "▲ LONG [" + sig_type_l + "] " + long_stars, style=label.style_label_up, color=long_col_s, textcolor=color.white, size=size.small)

if short_sig
    label.new(bar_index, high + atr * 0.5, "▼ SHORT [" + sig_type_s + "] " + short_stars, style=label.style_label_down, color=short_col_s, textcolor=color.white, size=size.small)

// ═══════════════════════════════════════════════════════════════════
// 🤖 BOT ENTRY MARKERS — ชัดเจน ใหญ่ สีสด
// เงื่อนไขตรงกับ bot Python จริง
// ═══════════════════════════════════════════════════════════════════
// Case 1: OB Retest — H4 bull + price retest OB from above + bull candle
bot_buy_ob    = h4_bull and in_bull_ob and bull_candle and not momentum_bear and is_tradeable
bot_sell_ob   = not h4_bull and in_bear_ob and bear_candle and not momentum_bull and is_tradeable

// Case 2: Sweep Grab — H4 align + strong grab candle after sweep
bot_buy_sweep  = h4_bull and bull_grab_strong and not momentum_bear and is_tradeable
bot_sell_sweep = not h4_bull and bear_grab_strong and not momentum_bull and is_tradeable

// Case 3: EQL/EQH Sweep recovery
bot_buy_eql  = eql_swept and bull_candle and not momentum_bear and is_tradeable
bot_sell_eqh = eqh_swept and bear_candle and not momentum_bull and is_tradeable

bot_buy  = i_show_bot and (bot_buy_ob  or bot_buy_sweep  or bot_buy_eql)
bot_sell = i_show_bot and (bot_sell_ob or bot_sell_sweep or bot_sell_eqh)

bot_buy_type  = bot_buy_eql   ? "EQL-SWEEP" : bot_buy_sweep   ? "SWEEP-GRAB" : "OB-RETEST"
bot_sell_type = bot_sell_eqh  ? "EQH-SWEEP" : bot_sell_sweep  ? "SWEEP-GRAB" : "OB-RETEST"

// BUY arrow — cyan ขนาดใหญ่ ด้านล่างแท่ง
if bot_buy
    label.new(bar_index, low - atr * 1.8, "🤖 BOT BUY\n" + bot_buy_type + " " + long_stars, style=label.style_label_up, color=#00E5FF, textcolor=#000000, size=size.normal)

// SELL arrow — orange ขนาดใหญ่ ด้านบนแท่ง
if bot_sell
    label.new(bar_index, high + atr * 1.8, "🤖 BOT SELL\n" + bot_sell_type + " " + short_stars, style=label.style_label_down, color=#FF6D00, textcolor=#FFFFFF, size=size.normal)

// ═══════════════════════════════════════════════════════════════════
// SL / TP LINES
// ═══════════════════════════════════════════════════════════════════
var line  sl_ln  = na
var line  tp_ln  = na
var label sltp_l = na

if long_sig and i_show_sltp
    sl = not na(bull_ob_bot) ? bull_ob_bot - atr * 0.1 : low - atr * 1.0
    tp = close + (close - sl) * i_rr_min
    label.delete(sltp_l)
    line.delete(sl_ln)
    line.delete(tp_ln)
    sl_ln  := line.new(bar_index, sl, bar_index + 40, sl, color=#FF5252, width=1, style=line.style_dashed)
    tp_ln  := line.new(bar_index, tp, bar_index + 40, tp, color=#00C853, width=1, style=line.style_dashed)
    rr     = (tp - close) / math.max(close - sl, 0.001)
    sltp_l := label.new(bar_index + 2, close, "SL " + str.tostring(math.round(sl, 2)) + "\nTP " + str.tostring(math.round(tp, 2)) + "\nRR 1:" + str.tostring(math.round(rr, 1)), style=label.style_label_right, color=color.new(#263238, 20), textcolor=color.white, size=size.tiny)

if short_sig and i_show_sltp
    sl = not na(bear_ob_top) ? bear_ob_top + atr * 0.1 : high + atr * 1.0
    tp = close - (sl - close) * i_rr_min
    label.delete(sltp_l)
    line.delete(sl_ln)
    line.delete(tp_ln)
    sl_ln  := line.new(bar_index, sl, bar_index + 40, sl, color=#FF5252, width=1, style=line.style_dashed)
    tp_ln  := line.new(bar_index, tp, bar_index + 40, tp, color=#00C853, width=1, style=line.style_dashed)
    rr     = (close - tp) / math.max(sl - close, 0.001)
    sltp_l := label.new(bar_index + 2, close, "SL " + str.tostring(math.round(sl, 2)) + "\nTP " + str.tostring(math.round(tp, 2)) + "\nRR 1:" + str.tostring(math.round(rr, 1)), style=label.style_label_right, color=color.new(#263238, 20), textcolor=color.white, size=size.tiny)

// ═══════════════════════════════════════════════════════════════════
// DASHBOARD TABLE
// ═══════════════════════════════════════════════════════════════════
var table dash = table.new(position.top_right, 2, 13, border_width=1, bgcolor=color.new(#0D0D1A, 10))

if barstate.islast
    sess_name  = is_overlap ? "LN+NY ⚡" : is_ny ? "New York" : is_london ? "London" : "Off-Hours"
    sess_color = is_overlap ? #9C27B0 : is_ny ? #F44336 : is_london ? #FFC107 : #616161

    table.cell(dash, 0, 0, "🤖 SAT-Bot", text_color=color.white, bgcolor=#1A237E, text_size=size.small)
    table.cell(dash, 1, 0, "v3.0",       text_color=color.white, bgcolor=#1A237E, text_size=size.small)

    table.cell(dash, 0, 1, "Session", text_color=#BDBDBD, text_size=size.tiny)
    table.cell(dash, 1, 1, sess_name, text_color=color.white, bgcolor=color.new(sess_color, 40), text_size=size.tiny)

    table.cell(dash, 0, 2, "D1",  text_color=#BDBDBD, text_size=size.tiny)
    table.cell(dash, 1, 2, d1_bull ? "▲ BULL" : "▼ BEAR", text_color=color.white, bgcolor=d1_bull ? color.new(#00E676, 50) : color.new(#FF1744, 50), text_size=size.tiny)

    table.cell(dash, 0, 3, "H4",  text_color=#BDBDBD, text_size=size.tiny)
    table.cell(dash, 1, 3, h4_bull ? "▲ BULL" : "▼ BEAR", text_color=color.white, bgcolor=h4_bull ? color.new(#00E676, 50) : color.new(#FF1744, 50), text_size=size.tiny)

    table.cell(dash, 0, 4, "H1",  text_color=#BDBDBD, text_size=size.tiny)
    table.cell(dash, 1, 4, h1_bull ? "▲ BULL" : "▼ BEAR", text_color=color.white, bgcolor=h1_bull ? color.new(#00E676, 50) : color.new(#FF1744, 50), text_size=size.tiny)

    table.cell(dash, 0, 5, "M5 Bias",  text_color=#BDBDBD, text_size=size.tiny)
    table.cell(dash, 1, 5, str.upper(bias), text_color=color.white, bgcolor=bias_bull ? color.new(#00E676, 40) : bias_bear ? color.new(#FF1744, 40) : color.new(#616161, 40), text_size=size.tiny)

    table.cell(dash, 0, 6, "Bull OB",  text_color=#BDBDBD, text_size=size.tiny)
    table.cell(dash, 1, 6, in_bull_ob ? "✓ RETEST" : "–", text_color=color.white, bgcolor=in_bull_ob ? color.new(#00E676, 40) : color.new(#333333, 0), text_size=size.tiny)

    table.cell(dash, 0, 7, "Bear OB",  text_color=#BDBDBD, text_size=size.tiny)
    table.cell(dash, 1, 7, in_bear_ob ? "✓ RETEST" : "–", text_color=color.white, bgcolor=in_bear_ob ? color.new(#FF1744, 40) : color.new(#333333, 0), text_size=size.tiny)

    table.cell(dash, 0, 8, "Sweep",  text_color=#BDBDBD, text_size=size.tiny)
    swp_txt = recent_sweep_l ? "🌊 Low" : recent_sweep_h ? "🌊 High" : "–"
    swp_col = recent_sweep_l ? #00E676 : recent_sweep_h ? #FF1744 : #616161
    table.cell(dash, 1, 8, swp_txt, text_color=color.white, bgcolor=color.new(swp_col, 50), text_size=size.tiny)

    table.cell(dash, 0, 9, "Momentum", text_color=#BDBDBD, text_size=size.tiny)
    mom_txt = momentum_bear ? "⚠ Bear" : momentum_bull ? "⚠ Bull" : "✓ Clear"
    mom_col = (momentum_bear or momentum_bull) ? #FF6F00 : #00C853
    table.cell(dash, 1, 9, mom_txt, text_color=color.white, bgcolor=color.new(mom_col, 40), text_size=size.tiny)

    table.cell(dash, 0, 10, "EQL/EQH", text_color=#BDBDBD, text_size=size.tiny)
    eql_txt = eql_swept ? "🟢 EQL SWEPT" : eqh_swept ? "🔴 EQH SWEPT" : near_eql ? "near EQL" : near_eqh ? "near EQH" : "–"
    eql_col = eql_swept ? #00E676 : eqh_swept ? #FF1744 : #616161
    table.cell(dash, 1, 10, eql_txt, text_color=color.white, bgcolor=color.new(eql_col, 50), text_size=size.tiny)

    bot_txt = bot_buy  ? "🤖 BUY "  + bot_buy_type  + " " + long_stars  :
              bot_sell ? "🤖 SELL " + bot_sell_type + " " + short_stars :
              long_sig ? "▲ LONG "  + long_stars  :
              short_sig ? "▼ SHORT " + short_stars : "– WAIT"
    bot_bg  = bot_buy ? #00E5FF : bot_sell ? #FF6D00 : long_sig ? #00C853 : short_sig ? #D50000 : #333333
    bot_tc  = bot_buy ? #000000 : color.white
    table.cell(dash, 0, 11, "Signal", text_color=#BDBDBD, text_size=size.tiny)
    table.cell(dash, 1, 11, bot_txt, text_color=bot_tc, bgcolor=color.new(bot_bg, 20), text_size=size.small)

    score_txt = bot_buy or long_sig ? str.tostring(long_score) + "/6" : bot_sell or short_sig ? str.tostring(short_score) + "/6" : "–"
    table.cell(dash, 0, 12, "Score", text_color=#BDBDBD, text_size=size.tiny)
    table.cell(dash, 1, 12, score_txt, text_color=color.white, text_size=size.tiny)

// ═══════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════
alertcondition(bot_buy,    title="🤖 BOT BUY",    message="SAT-Bot: 🤖 BUY [{{ticker}} M5] Price={{close}}")
alertcondition(bot_sell,   title="🤖 BOT SELL",   message="SAT-Bot: 🤖 SELL [{{ticker}} M5] Price={{close}}")
alertcondition(long_sig,   title="LONG Signal",    message="SAT-Bot: ▲ LONG [{{ticker}} M5] Price={{close}}")
alertcondition(short_sig,  title="SHORT Signal",   message="SAT-Bot: ▼ SHORT [{{ticker}} M5] Price={{close}}")
alertcondition(sweep_low,  title="Sweep Low",      message="SAT-Bot: 🌊 Sweep Low [{{ticker}}] Price={{close}}")
alertcondition(sweep_high, title="Sweep High",     message="SAT-Bot: 🌊 Sweep High [{{ticker}}] Price={{close}}")
alertcondition(eql_swept,  title="EQL Swept → BUY",  message="SAT-Bot: EQL Swept [{{ticker}}] Price={{close}}")
alertcondition(eqh_swept,  title="EQH Swept → SELL", message="SAT-Bot: EQH Swept [{{ticker}}] Price={{close}}")
